# Bezpečnostní hlavičky a cache (Apache). Na Nginx viz README.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # HTML, skripty, styly a manifest: vždy ověřit u serveru (aktualizace hned po vydání)
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.png$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
Options -Indexes
